# ═══════════════════════════════════════════════════════════════════════════
#  deploy/env.prod.example — PLANTILLA de variables del despliegue Linux
# ═══════════════════════════════════════════════════════════════════════════
#  Copiar a la RAÍZ del repo clonado en el servidor como `.env` y reemplazar
#  TODO valor por secretos REALES (el .env real NUNCA se versiona):
#
#      cp deploy/env.prod.example .env
#
#  deploy/compose.prod.yaml exige estas variables con ${VAR:?}: si falta una,
#  el compose falla en seco antes de levantar nada — nunca hereda defaults.
# ═══════════════════════════════════════════════════════════════════════════

# ─── OBLIGATORIAS ────────────────────────────────────────────────────────────
# Contraseña del root de MySQL del contenedor de BD (protege la administración)
MYSQL_ROOT_PASSWORD=

# Cuenta de la APLICACIÓN (DML-only sobre jadda_sports_db; la crea
# scripts/sql/usuarios-produccion.sql, que aplica scripts/desplegar-prod.sh)
DB_PASSWORD=

# Cuenta MIGRADORA (DDL + DML; crea tablas, migraciones, seeds y el admin)
MIGRATE_DB_PASSWORD=

# Firma de las cookies de sesión (generar con):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Cuenta de administrador que siembra la PRIMERA corrida y con la que entra
# al panel (producción NO tiene defaults para estas dos):
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── OPCIONALES (con default razonable si se omiten) ────────────────────────
# MIGRATE_DB_USER=jadda_migrator      # usuario migrador (default este)
# DB_USER=jadda_app                   # usuario de la app (default este)
# CORS_ORIGINS=                       # solo si el SPA se sirve en otra origin
# GLOBAL_RATELIMIT_MAX=300            # techo global por IP (default 300)
# TRUST_PROXY=2                       # proxys delante del backend (default 2)

# NOTA correos/Cloudinary/OAuth (tomar datos de backend/.env.example):
# son integraciones AUXILIARES y el repo clonado NO trae backend/.env.
# Si el despliegue las quiere, crear backend/.env en el servidor con esos
# valores; sin él la app arranca igual y únicamente esas notificaciones
# quedan omitidas (best-effort, nunca bloquean la compra).
