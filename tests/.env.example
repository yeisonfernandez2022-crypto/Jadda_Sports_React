# Credenciales para el suite de humo (tests/smoke.mjs y tests/e2e/*).
# Copia este archivo a tests/.env y llena los valores REALES de tu despliegue.
# tests/.env esta en .gitignore (jamas lo subas al repositorio).
API_URL=http://localhost:5000
WEB_URL=http://localhost:5173

# Cuenta administradora del seed (ADMIN_EMAIL/ADMIN_PASSWORD del .env del backend)
ADMIN_EMAIL=TU_CORREO_ADMIN
ADMIN_PASS=TU_PASSWORD_ADMIN

# Cuenta de vendedor con productos vendidos (solo para los checks ES_DE_VENDEDOR).
# En CI se autogenera; en local usa un vendedor real de tu despliegue.
VENDOR_EMAIL=TU_CORREO_VENDEDOR
VENDOR_PASS=TU_PASSWORD_VENDEDOR
