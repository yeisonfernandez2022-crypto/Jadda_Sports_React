# ============================================================================
# JADDA SPORTS — variables de entorno RAÍZ (docker compose)
# ============================================================================
# Copia este archivo a `.env` y rellena los valores:
#     cp .env.example .env      (Windows: copy .env.example .env)
#
# Los placeholders NUNCA contienen credenciales reales. Las claves marcadas
# [OBLIGATORIA] hacen que `docker compose up` falle si faltan (interpolación
# `:?` en deploy/compose.prod.yaml y valor vacío en dev). El detalle de cada
# variable está en backend/.env.example y docs/manuales/manual-instalacion.md.
#
# NOTA (2026-11-08, corte a TiDB): el backend dev de docker-compose.yml se
# conecta por defecto a TiDB Cloud (TIDB_*). Para volver a la BD MySQL local
# del compose, borra las 5 líneas TIDB_* y descomenta DB_* (el rollback está
# documentado en el propio docker-compose.yml; el volumen mysql_data conserva
# el espejo de la BD de antes del corte).
# ============================================================================

# --- MySQL local (contenedor `database` del compose) ------------------------
# [OBLIGATORIA] Contraseña root del MySQL del compose (dev y prod).
MYSQL_ROOT_PASSWORD=
# Contraseña del usuario root que el backend usa si conectas a la BD LOCAL
# (solo necesaria en el rollback a MySQL; ver comentario de arriba).
DB_PASSWORD=

# --- TiDB Cloud (BD serverless de desarrollo y producción) ------------------
# [OBLIGATORIAS mientras el compose apunte a TiDB] Datos del cluster Starter
# (host gateway..., puerto 4000, TLS forzado por DB_SSL=true en el compose).
# Si no usas TiDB, déjalas vacías y usa las DB_* locales de arriba.
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=

# --- Opcionales (valores default en el compose) -----------------------------
# Techo global anti-abuso: peticiones por minuto por IP (default 300).
GLOBAL_RATELIMIT_MAX=300
# `true` = las IPs privadas/loopback no compiten en el cubo global (dev).
GLOBAL_RATELIMIT_RESTRICCION_LOCAL=true
# Modo del contenedor frontend en dev: `dev` (Vite HMR, default) o `preview`
# (build de producción servido). Dejar vacío para desarrollo.
MODE=
