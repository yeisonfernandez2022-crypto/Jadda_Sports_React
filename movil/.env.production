# Variables para builds de produccion (EAS Build) y OTA (EAS Update).
# Son URLs publicas del backend/frontend desplegados en Render — no contienen secretos.
# El desarrollo local sigue usando .env (LAN).
EXPO_PUBLIC_API_URL=https://jadda-backend.onrender.com
EXPO_PUBLIC_FRONT_URL=https://jadda-frontend.onrender.com
