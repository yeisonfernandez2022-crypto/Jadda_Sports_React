# ====================================================================
# JADDA SPORTS - App Móvil (.env.example)
# Copia este archivo a .env y llena los valores con tus datos reales.
# NUNCA subas el .env real a git (ya está en .gitignore).
# ====================================================================

# URL del backend Express (API). Usa la IP LAN de tu PC (no localhost
# si pruebas desde un celular físico). Expo lee esto al arrancar.
EXPO_PUBLIC_API_URL=http://TU_IP_LAN:5000

# URL del frontend web (Vite), donde se sirven las imágenes locales
# (/images/...). Normalmente la misma IP LAN pero puerto 5173.
EXPO_PUBLIC_FRONT_URL=http://TU_IP_LAN:5173

# OAuth Google (login social)
# Client ID principal (se usa como web y como fallback para android/ios).
EXPO_PUBLIC_GOOGLE_CLIENT_ID=TU_CLIENT_ID_GOOGLE
# Opcional: client IDs específicos por plataforma (si los creaste aparte en
# Google Cloud). Si no se definen, se usa EXPO_PUBLIC_GOOGLE_CLIENT_ID.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=TU_CLIENT_ID_GOOGLE_ANDROID
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=TU_CLIENT_ID_GOOGLE_IOS

# OAuth Facebook (login social)
EXPO_PUBLIC_FACEBOOK_CLIENT_ID=TU_CLIENT_ID_FACEBOOK
