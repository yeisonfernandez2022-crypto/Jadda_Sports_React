# Dockerfile de PRODUCCIÓN del backend (solo deps de runtime, sin nodemon).
FROM node:22-alpine

WORKDIR /app

# pnpm FIJADO (11.8.0 — la que se usa en el host y genera pnpm-lock.yaml):
# pnpm@latest hacía que builds distintos con distinto tiempo de vida
# resolvieran versiones distintas y dependieran de variantes de lockfile.
RUN corepack enable && corepack prepare pnpm@11.8.0 --activate

# Dependencias primero para aprovechar la caché de capas
# pnpm-workspace.yaml VA con el lock: la lockfile se generó con los overrides
# de seguridad y sin el archivo pnpm aborta el --frozen (config mismatch).
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --prod

# S6470: copia GRANULAR del código de runtime (nada sensible entra al
# contenedor y el .dockerignore deja de ser la única barrera). El árbol
# espejo de lo que ejecuta la app (assets/config/controllers/database/
# middlewares/public/routes/utils + server.js).
COPY assets ./assets
COPY config ./config
COPY controllers ./controllers
COPY database ./database
# docs/openapi.js es la spec de Swagger consumida por routes/docsRoutes.js al arrancar
COPY docs ./docs
COPY middlewares ./middlewares
COPY routes ./routes
COPY utils ./utils
COPY server.js ./server.js

ENV NODE_ENV=production
EXPOSE 5000

# S6471: runtime SIN root (uid 1000 del usuario node coincide con el uid
# 1000 del usuario ubuntu del host Oracle; el bind de uploads/ sigue siendo
# escribible por el proceso). La build usa root para pnpm; el runtime no.
RUN chown -R node:node /app
USER node

CMD ["node", "server.js"]