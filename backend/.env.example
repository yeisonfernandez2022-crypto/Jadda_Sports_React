# =====================================================
# JADDA SPORTS - Backend (.env de ejemplo — SOLO placeholders)
# Copia a `.env` y llena con tus valores reales (el .env real está en .gitignore).
# =====================================================

# --- Base de datos MySQL ---
DB_HOST=database
DB_USER=root
DB_PASSWORD=TU_PASSWORD_MYSQL
DB_NAME=jadda_sports_db

# --- Puerto del backend ---
PORT=5000

# --- Sesiones ---
SESSION_SECRET=TU_SECRETO_DE_SESION

# --- Correo (Nodemailer / contraseña de aplicación de Gmail) ---
EMAIL_USER=TU_CORREO_GMAIL@gmail.com
EMAIL_PASS=TU_CONTRASEÑA_DE_APLICACION

# --- OAuth (Google / Facebook) ---
GOOGLE_CLIENT_ID=TU_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=TU_GOOGLE_CLIENT_SECRET
FACEBOOK_CLIENT_ID=TU_FACEBOOK_CLIENT_ID
FACEBOOK_CLIENT_SECRET=TU_FACEBOOK_CLIENT_SECRET

# --- URL del frontend (usada en correos: checkout, avisos, newsletter) ---
FRONTEND_URL=http://localhost:5173

# --- Cuenta administrador (seed) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CambiaEstaPassword

# --- Newsletter automática ---
# Intervalo entre envíos de la newsletter (horas). Por defecto 72 (cada 3 días).
NEWSLETTER_INTERVAL_HORAS=72
