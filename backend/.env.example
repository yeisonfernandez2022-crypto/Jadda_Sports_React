# =====================================================
# JADDA SPORTS - Backend (.env de ejemplo — SOLO placeholders)
# Copia a `.env` y llena con tus valores reales (el .env real está en .gitignore).
# =====================================================

# --- Base de datos MySQL ---
DB_HOST=database
DB_USER=root
DB_PASSWORD=__DEFINIR_DB_PASSWORD__
DB_NAME=jadda_sports_db
# La aplicación sin NODE_ENV=production permite arrancar sin DB_PASSWORD
# (fallará al conectar). En PRODUCCIÓN es obligatoria: fail-fast.

# --- Puerto del backend ---
PORT=5000

# --- Entorno ---
# NODE_ENV=production activa: cookies Secure (pide HTTPS), exige SESSION_SECRET
# y ADMIN_EMAIL/ADMIN_PASSWORD, y NO siembra datos de demostración.
# NODE_ENV=development

# Alternativa sin NODE_ENV: siembra de demostración apagada explícitamente.
# DEMO_DATA=false

# --- Sesiones ---
SESSION_SECRET=TU_SECRETO_DE_SESION

# --- CORS y defensa CSRF ---
# Dominios web adicionales admitidos (producción), separados por coma y sin
# slash final — añaden a la base de desarrollo (localhost:5173/8081):
# CORS_ORIGINS=https://www.jaddasports.com,https://jaddasports.com
# Saltos de proxy confiables para resolver req.ip (rate limiting por IP real).
# El compose de producción define TRUST_PROXY: 2 (borde + nginx interno de la
# SPA → backend); si corres el backend solo detrás de un proxy, queda en 1.
# TRUST_PROXY=1

# --- Geolocalización de la última conexión (opt-in) ---
# Con true, el login consulta ipwho.is POR HTTPS para guardar "ciudad, región,
# país" junto a la última IP (perfil → Seguridad). Por defecto false: NO se
# consulta ningún tercero y solo se guarda fecha + IP.
# GEOLOCALIZAR_IP=true

# --- Correo (Nodemailer / contraseña de aplicación de Gmail) ---
EMAIL_USER=TU_CORREO_GMAIL@gmail.com
EMAIL_PASS=TU_CONTRASEÑA_DE_APLICACION

# --- OAuth (Google / Facebook) ---
GOOGLE_CLIENT_ID=TU_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=TU_GOOGLE_CLIENT_SECRET
FACEBOOK_CLIENT_ID=TU_FACEBOOK_CLIENT_ID
FACEBOOK_CLIENT_SECRET=TU_FACEBOOK_CLIENT_SECRET

# --- URL del frontend (usada en correos: checkout, avisos, newsletter) ---
FRONTEND_URL=http://localhost:5173

# --- Cloudinary (imágenes y videos subidos) ---
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Si se omite, las subidas se guardan en disco local (modo desarrollo).
CLOUDINARY_URL=cloudinary://TU_API_KEY:TU_API_SECRET@TU_CLOUD_NAME

# --- Cuenta administrador (seed) ---
# En producción ambas son obligatorias. En desarrollo, sin ADMIN_EMAIL el
# setup omite la verificación del admin. Los valores reales NUNCA van aquí.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=__DEFINIR_ADMIN_PASSWORD__

# --- Migraciones al arranque (FASE 2 cierre-produccion) ---
# En producción el DDL corre con `pnpm migrate` (servicio `migrate` en
# docker-compose.prod.yml) y el servidor NO lo ejecuta al arrancar.
# Escapa SOLO en emergencias con true (migra al arrancar; equivale al modo
# desarrollo y se recomienda volver a usar pnpm migrate después). En
# desarrollo no aplica: se migra siempre, con o sin esta variable.
RUN_MIGRATIONS_ON_BOOT=

# --- Newsletter automática ---
# Intervalo entre envíos de la newsletter (horas). Por defecto 72 (cada 3 días).
NEWSLETTER_INTERVAL_HORAS=72

# --- Pasarela de pagos (Wompi) ---
# SI se define PAYMENT_GATEWAY=wompi, la venta nace con estado PENDIENTE_PAGO y
# se confirma vía webhook firmado / GET /api/pagos/estado. Mientras está vacía
# (modo sin pasarela) la venta nace COMPLETADA y todo funciona como antes.
# Ventana de pago: si el cliente no completa el pago, la venta PENDIENTE_PAGO
# se cancela sola (reingresa stock) al vencer; abrir el checkout de nuevo
# ("Pagar ahora") reinicia el reloj. Mínimo 1, default 10 (antes 48 h).
PAGOS_EXPIRA_MINUTOS=10
# Llaves de SANDBOX (pruebas) — en docs.wompi.co → Datos de prueba en Sandbox:
# tarjeta 4242 4242 4242 4242 (APPROVED) · PSE banco 3991 1 11 111 (APPROVED)
# y 3992 2 22 222 (DECLINED). Las llaves reales NUNCA van en este archivo.
PAYMENT_GATEWAY=
# EN PRODUCCIÓN la pasarela es OBLIGATORIA: sin PAYMENT_GATEWAY=wompi + las 4
# WOMPI_* el backend se niega a arrancar. Escapa SOLO para demostraciones con
# ALLOW_SIMULATED_PAYMENTS=true (queda aviso fuerte en el log; NUNCA junto a
# dinero real). En desarrollo esta validación no corre.
ALLOW_SIMULATED_PAYMENTS=
WOMPI_PUBLIC_KEY=pub_test_TU_LLAVE_PUBLICA
WOMPI_PRIVATE_KEY=prv_test_TU_LLAVE_PRIVADA
WOMPI_EVENTS_SECRET=test_events_TU_SECRETO_DE_EVENTOS
WOMPI_INTEGRITY_KEY=test_integrity_TU_LLAVE_DE_INTEGRIDAD
