mysql_data/
backups/

# Env reales — solo .env.example se trackea
.env
backend/.env
frontend/.env
movil/.env
*.env.local

# Credenciales de la suite de humo (copia local de tests/.env.example)
tests/.env

# Copia local del SQL de usuarios de producción con la clave real
scripts/sql/usuarios-produccion.local.sql

# Logs / temporales
reinicio.tmp
backups/backup.log

# pnpm workspace (raíz) — ignora node_modules de la raíz pero conserva tests/node_modules aislado
/node_modules/

# pnpm store global (no commitear)
.pnpm-store/

# Test coverage reports
backend/coverage/
frontend/coverage/

# Test database volume
mysql_test_data/

# Test node_modules (tests/ has isolated playwright-core)
tests/node_modules/
tests/node_modules/.ignored/

# Artefactos generados por la suite E2E
tests/playwright-output/
tests/playwright-report/
tests/playwright-results.json
tests/trace/

# Documentos de tesis: dependencias y volcados generados (no versionar)
outputs/**/node_modules/
*.inspect.ndjson

# Build outputs
frontend/dist/
backend/dist/
movil/dist/
movil/build/
*.tsbuildinfo

# Vite cache
frontend/.vite/
movil/.vite/

# Integration test coverage
backend/coverage/integration/

# Playwright test results
tests/test-results/

# Dove Docker volumes (local development)
backend/uploads/
!backend/uploads/.gitkeep

# Certificados TLS de producción (deploy/certs) — nunca versionar llaves
deploy/certs/
!deploy/certs/.gitkeep
frontend/public/images/productos/subidas/
!frontend/public/images/productos/subidas/.gitkeep
frontend/public/images/perfiles/
!frontend/public/images/perfiles/.gitkeep
frontend/public/images/retos/
!frontend/public/images/retos/.gitkeep
frontend/public/images/devoluciones/
!frontend/public/images/devoluciones/.gitkeep
frontend/public/images/usuarios/
!frontend/public/images/usuarios/.gitkeep

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# TypeScript cache
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

