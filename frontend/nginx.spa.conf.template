# ═══════════════════════════════════════════════════════════════════════════
#  frontend/nginx.spa.conf.template — Nginx INTERNO de la SPA (S04)
# ═══════════════════════════════════════════════════════════════════════════
#  Sirve el dist de Vite y reproduce el proxy de desarrollo (/api y /images →
#  backend) para que las cookies funcionen same-origin en TODO el tránsito.
#  El nginx de borde (deploy/nginx.conf → 80/443 TLS) apunta a ESTE servicio,
#  no al nodo.
#
#  LLEVA DENTRO DE LA IMAGEN (frontend/Dockerfile.prod lo copia a
#  /etc/nginx/templates/default.conf.template): la imagen oficial de nginx
#  ejecuta envsubst al arrancar y SUSTITUYE SOLO las variables de entorno
#  definidas (el resto, como $host o $scheme del propio nginx, queda intacto).
#
#  Variables (con defaults de Dockerfile.prod, sobrescribibles por entorno):
#    PORT          puerto de escucha del servidor de estáticos
#                  (default 80 en compose; Render lo pone a 10000).
#    BACKEND_HOST  hostname del backend (default "backend" en la red compose;
#                  en Render = el nombre del servicio, p. ej. "jadda-backend").
#    BACKEND_PORT  puerto del backend (default 5000 en compose; 10000 en Render).
#
#  Comportamiento en producción (Fase 4-2): el backend corre con TRUST_PROXY=2
#  (dos saltos) y espera X-Forwarded-Proto https y la cadena completa de
#  X-Forwarded-For + X-Real-IP del cliente real; si el borde no mandó el
#  header, $scheme/$remote_addr es el valor honesto de este hop.
# ═══════════════════════════════════════════════════════════════════════════

map $http_x_forwarded_proto $proto_original {
    default $http_x_forwarded_proto;
    ''      $scheme;
}
map $http_x_real_ip $real_ip_original {
    default $http_x_real_ip;
    ''      $remote_addr;
}

server {
    listen ${PORT};
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    # Límite de subida (Fase 4-2, punto 1 + P9 pulido): por defecto API y
    # páginas viven con el mínimo nginx (1m). Solo las rutas de SUBIDA (más
    # abajo, en nested location) se abren a 200m: fotos de producto en base64
    # (~25 MB tras inflar 4/3) y evidencias multipart (5 × 25 MB).
    # Mantener la MISMA lista que el nginx de borde (deploy/nginx.conf).
    client_max_body_size 1m;

    # Compresión de texto (los assets Vite van con hash + largo caché)
    gzip on;
    gzip_vary on;
    gzip_types text/css text/plain text/csv application/javascript application/json image/svg+xml;

    # Cachés de larga vida para assets con fingerprint (Vite las numera)
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Logo y favicon del directorio public (sin hash)
    location = /LogoJadda.png {
        expires 7d;
        try_files $uri =404;
    }
    location = /favicon.ico {
        expires 7d;
        try_files $uri =404;
    }

    # API → proxa al backend (cookies SameSite=Lax same-origin; cabeceras
    # X-Forwarded-* para que el backend confíe en su TRUST_PROXY). Se reenvían
    # explícitamente las decisiones conservadas del hop anterior (map $*).
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Proto $proto_original;
        proxy_set_header X-Real-IP         $real_ip_original;

        # Subidas grandes (Fase 4-2): sin buffering en disco del proxy y
        # timeout amplio para la cadena borde→SPA→backend.
        proxy_request_buffering off;
        proxy_read_timeout 120s;

        # Rutas de SUBIDA (P9): mismas que el nginx de borde —
        # auth/foto (base64 avatar), productos/imagenes (base64 producto),
        # devoluciones (evidencias multipart), retos/progreso (evidencias).
        location ~ ^/api/(auth/foto|productos/imagenes|devoluciones(/.*)?|retos/progreso/[0-9]+)$ {
            client_max_body_size 200m;
        }
    }

    # Los medios privados (perfiles/usuarios/devoluciones) los sirve el propio
    # backend con AUTORIZACIÓN (owner/vendedor/admin) — nada de cachearlos aquí.
    location /images/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        # Igual que /api: conservar la decisión del proxy de entrada.
        proxy_set_header X-Forwarded-Proto $proto_original;
        proxy_set_header X-Real-IP         $real_ip_original;
    }

    # SPA fallback: cualquier otra ruta (privada /admin/*, /perfil/*…) renderiza
    # el index del router
    location / {
        try_files $uri /index.html;
    }
}
