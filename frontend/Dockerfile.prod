# Dockerfile de PRODUCCIÓN del frontend — MULTI-STAGE (Fase 3 cierre-produccion)
# ─ Stage 1 (node): instala dependencias y construye el dist.
# ─ Stage 2 (nginx:alpine): sirve los assets estáticos y proxea /api y
#   /images al backend (deploy/nginx.spa.conf vinculada por compose).
# Antes: el runtime era `vite preview` (un servidor de desarrollo sirviendo
# producción) — el nodo ocupaba RAM y Vite quedaba expuesto de más.

# ─── Stage 1: build ───
FROM node:22-alpine AS build

WORKDIR /app

# pnpm FIJADO (11.8.0 — la versión con la que se genera el lockfile);
# ver Dockerfile.prod del backend para la nota de corepack.
RUN corepack enable && corepack prepare pnpm@11.8.0 --activate

# Dependencias primero para aprovechar la caché de capas
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm build

# ─── Stage 2: runtime nginx ───
FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
