# Dockerfile de PRODUCCIÓN del frontend — MULTI-STAGE (Fase 3 cierre-produccion)
# ─ Stage 1 (node): instala dependencias y construye el dist.
# ─ Stage 2 (nginx:alpine): sirve los assets estáticos y proxea /api y
#   /images al backend (nginx.spa.conf.template incluida en la imagen).
# Antes: el runtime era `vite preview` (un servidor de desarrollo sirviendo
# producción) — el nodo ocupaba RAM y Vite quedaba expuesto de más.

# ─── Stage 1: build ───
FROM node:22-alpine AS build

WORKDIR /app

# pnpm FIJADO (11.8.0 — la versión con la que se genera el lockfile);
# ver Dockerfile.prod del backend para la nota de corepack.
RUN corepack enable && corepack prepare pnpm@11.8.0 --activate

# Dependencias primero para aprovechar la caché de capas
# pnpm-workspace.yaml VA con el lock (controla los overrides de seguridad);
# sin el archivo pnpm aborta el --frozen (ERR_PNPM_LOCKFILE_CONFIG_MISMATCH).
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm build

# ─── Stage 2: runtime nginx ───
FROM nginx:alpine

# Conf del nginx interno DENTRO de la imagen (S04): la imagen oficial de
# nginx evalúa /etc/nginx/templates/*.template con envsubst al arrancar —
# sustituye SOLO las variables de entorno definidas (defaults de abajo,
# sobrescribibles en runtime — p. ej. PORT, BACKEND_ORIGEN, DNS_RESOLVER —)
# y deja intacto
# lo demás ($host, $scheme, $proxy_add_x_forwarded_for…): los `$` de nginx no
# definidos en el entorno NO se tocan, por eso el mecanismo es seguro.
COPY nginx.spa.conf.template /etc/nginx/templates/default.conf.template
# Snippet COMPARTIDO del proxy al backend: location /api/ y la location regex
# de SUBIDAS lo incluyen (ver nginx.proxy-backend.conf). Copia VERBATIM a
# /etc/nginx/snippets/ — de propósito NO en templates/: envsubst escribiría
# el resultado en conf.d/ y nginx lo cargaría en contexto http, donde
# proxy_pass no es válido (crash de arranque).
COPY nginx.proxy-backend.conf /etc/nginx/snippets/proxy-backend.conf
# BACKEND_ORIGEN: origen COMPLETO del backend para el proxy_pass con
# variable (ver nginx.spa.conf.template) — en la red compose resuelve
# `backend` con el DNS embebido de Docker (127.0.0.11).
ENV PORT=80 BACKEND_ORIGEN=http://backend:5000 DNS_RESOLVER=127.0.0.11

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
