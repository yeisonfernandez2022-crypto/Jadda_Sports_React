# Dockerfile de PRODUCCIÓN del frontend: construye el dist y lo sirve con
# `vite preview` (mismo proxy /api,/images que el dev — ver vite.config.ts).
FROM node:22-alpine

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate && pnpm config set minimum-release-age 0

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm build

ENV NODE_ENV=production
EXPOSE 5173

CMD ["pnpm", "preview", "--host", "0.0.0.0", "--port", "5173", "--strictPort"]
